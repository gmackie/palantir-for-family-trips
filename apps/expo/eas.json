{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote",
    "requireCommit": false
  },
  "build": {
    "base": {
      "node": "22.16.0",
      "pnpm": "10.32.1",
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "SENTRY_ORG": "${SENTRY_ORG}",
        "SENTRY_PROJECT": "${SENTRY_PROJECT_MOBILE}",
        "SENTRY_AUTH_TOKEN": "${SENTRY_AUTH_TOKEN}",
        "GOOGLE_MAPS_API_KEY": "${GOOGLE_MAPS_API_KEY}"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development",
        "API_URL": "https://sortey.app",
        "SENTRY_DSN": "${EXPO_PUBLIC_SENTRY_DSN_DEV}",
        "POSTHOG_KEY": "${EXPO_PUBLIC_POSTHOG_KEY_DEV}",
        "POSTHOG_HOST": "${EXPO_PUBLIC_POSTHOG_HOST}"
      },
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "channel": "development"
    },
    "development-device": {
      "extends": "development",
      "ios": {
        "simulator": false
      }
    },
    "trip-device": {
      "extends": "development-device",
      "environment": "development",
      "developmentClient": false
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "preview",
        "API_URL": "${STAGING_API_URL}",
        "SENTRY_DSN": "${EXPO_PUBLIC_SENTRY_DSN_STAGING}",
        "POSTHOG_KEY": "${EXPO_PUBLIC_POSTHOG_KEY_STAGING}",
        "POSTHOG_HOST": "${EXPO_PUBLIC_POSTHOG_HOST}"
      },
      "ios": {
        "enterpriseProvisioning": "adhoc"
      },
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "API_URL": "https://sortey.app",
        "EXPO_PUBLIC_APP_DOMAIN": "sortey.app",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "ios": {
        "enterpriseProvisioning": "universal"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "${APPLE_ID}",
        "ascAppId": "6775057200",
        "appleTeamId": "${APPLE_TEAM_ID}"
      },
      "android": {
        "serviceAccountKeyPath": "./google-services.json",
        "track": "internal"
      }
    },
    "preview": {
      "ios": {
        "appleId": "${APPLE_ID}",
        "ascAppId": "6775057200",
        "appleTeamId": "${APPLE_TEAM_ID}"
      },
      "android": {
        "serviceAccountKeyPath": "./google-services.json",
        "track": "internal"
      }
    }
  }
}
