{
  "name": "@sortey/expo",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "clean": "git clean -xdf .cache .expo .turbo android ios node_modules",
    "dev": "expo start",
    "dev:client": "expo start --dev-client",
    "dev:android": "expo start --android",
    "dev:ios": "expo start --ios",
    "build:device:ios": "eas build --profile development-device --platform ios",
    "build:device:android": "eas build --profile development-device --platform android",
    "build:preview:sim:local": "npx eas-cli@20.5.1 build --profile preview-simulator --platform ios --local --non-interactive",
    "build:preview:device:local": "npx eas-cli@20.5.1 build --profile preview-device --platform ios --local --non-interactive",
    "build:preview:device": "npx eas-cli@20.5.1 build --profile preview-device --platform ios --non-interactive",
    "eas-build-post-install": "pnpm --workspace-root turbo run build --filter=@sortey/expo...",
    "update:development": "npx eas-cli@20.5.1 update --channel development --environment development --non-interactive",
    "update:preview": "npx eas-cli@20.5.1 update --channel preview --environment preview --non-interactive",
    "update:production": "npx eas-cli@20.5.1 update --channel production --environment production --non-interactive",
    "update:production:rollout": "npx eas-cli@20.5.1 update --channel production --environment production --rollout-percentage 10 --non-interactive",
    "check:app-store": "node ./scripts/check-app-store-readiness.mjs",
    "submit:ios": "eas submit --platform ios --profile production --latest --non-interactive --wait",
    "submit:ios:id": "eas submit --platform ios --profile production --non-interactive --wait --id",
    "build:ios:production": "eas build --platform ios --profile production --non-interactive",
    "build:ios:production:submit": "eas build --platform ios --profile production --auto-submit --non-interactive",
    "fastlane:beta": "bundle exec fastlane ios beta",
    "fastlane:pilot": "bundle exec fastlane ios pilot_eas_latest",
    "fastlane:meta": "bundle exec fastlane ios store_listing",
    "fastlane:screenshots": "bundle exec fastlane ios sync_screenshots",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "e2e": "maestro test .maestro/",
    "e2e:record": "maestro record",
    "e2e:studio": "maestro studio",
    "preflight:ios": "/Volumes/dev/preflight/preflight prove-app --app-dir . --platform ios --lane simulator --wait-for-runner",
    "preflight:android": "/Volumes/dev/preflight/preflight prove-app --app-dir . --platform android --lane simulator --wait-for-runner",
    "preflight:local": "/Volumes/dev/preflight/preflight prove-app --app-dir . --platform ios --lane simulator --local-readiness",
    "preflight:preview:sim": "/Volumes/dev/preflight/preflight prove-app --app-dir . --platform ios --lane simulator --build-strategy local --wait-for-runner",
    "preflight:preview:device": "/Volumes/dev/preflight/preflight prove-app --app-dir . --platform ios --lane development --build-strategy local --wait-for-runner",
    "format": "biome check .",
    "lint": "oxlint .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "ota:publish:preview": "node --experimental-strip-types /Volumes/dev/preflight-app/packages/ota/scripts/publish-local.mjs --app sortey --channel preview --platform ios",
    "ota:publish:development": "node --experimental-strip-types /Volumes/dev/preflight-app/packages/ota/scripts/publish-local.mjs --app sortey --channel development --platform ios"
  },
  "dependencies": {
    "@better-auth/expo": "catalog:",
    "@expo/dom-webview": "~56.0.6",
    "@expo/metro-runtime": "~56.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@legendapp/list": "^2.0.19",
    "@react-native-community/netinfo": "^12.0.1",
    "@sentry/react-native": "~7.11.0",
    "@sortey/analytics": "workspace:*",
    "@sortey/config": "workspace:*",
    "@sortey/i18n": "workspace:*",
    "@sortey/monitoring": "workspace:*",
    "@sortey/realtime": "workspace:*",
    "@sortey/validators": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@trpc/tanstack-react-query": "catalog:",
    "better-auth": "catalog:",
    "buffer": "^6.0.3",
    "dotenv-expand": "^11.0.6",
    "expo": "~56.0.13",
    "expo-apple-authentication": "~56.0.4",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.19",
    "expo-dev-client": "~56.0.21",
    "expo-file-system": "~56.0.0",
    "expo-image-manipulator": "~56.0.20",
    "expo-image-picker": "~56.0.19",
    "expo-linking": "~56.0.14",
    "expo-localization": "~56.0.6",
    "expo-location": "~56.0.19",
    "expo-network": "~56.0.5",
    "expo-notifications": "~56.0.19",
    "expo-router": "~56.2.12",
    "expo-secure-store": "~56.0.4",
    "expo-share-intent": "^7.0.0",
    "expo-splash-screen": "~56.0.11",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.20",
    "expo-web-browser": "~56.0.5",
    "i18next": "^26.2.0",
    "nativewind": "5.0.0-preview.2",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-i18next": "^17.0.8",
    "react-native": "0.85.3",
    "react-native-css": "3.0.7",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-maps": "^1.27.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.8.3",
    "superjson": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@sentry/cli": "3.4.1",
    "@sortey/api": "workspace:*",
    "@sortey/tailwind-config": "workspace:*",
    "@sortey/tsconfig": "workspace:*",
    "@types/react": "catalog:react19",
    "babel-preset-expo": "56.0.11",
    "metro-cache": "0.83.7",
    "oxlint": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.7"
  }
}
