{
  "name": "@sortey/nextjs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm with-env next build",
    "clean": "git clean -xdf .cache .next .turbo node_modules playwright-report storybook-static test-results",
    "dev": "pnpm with-env next dev",
    "dev:vinext": "pnpm prebuild:vinext && VINEXT=1 pnpm with-env vinext dev --port 3001",
    "build:vinext": "pnpm prebuild:vinext && VINEXT=1 pnpm with-env vinext build && pnpm sync:vinext-wrangler",
    "start:vinext": "VINEXT=1 pnpm with-env vinext start",
    "prebuild:vinext": "pnpm --dir ../.. --filter @sortey/nextjs^... build",
    "sync:vinext-wrangler": "node ./scripts/sync-vinext-wrangler.mjs",
    "deploy:cloudflare": "pnpm deploy:cloudflare:production",
    "deploy:cloudflare:staging": "pnpm build:vinext && pnpm with-env wrangler deploy -c dist/server/wrangler.json --env staging",
    "deploy:cloudflare:production": "pnpm build:vinext && pnpm with-env wrangler deploy -c dist/server/wrangler.json",
    "format": "biome check .",
    "lint": "oxlint .",
    "test": "vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest --config vitest.worker.config.ts",
    "storybook": "SKIP_ENV_VALIDATION=1 storybook dev -p 6006",
    "storybook:build": "SKIP_ENV_VALIDATION=1 storybook build",
    "start": "pnpm with-env next start",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@forgegraph/otel": "^0.1.1",
    "@googlemaps/js-api-loader": "^2.0.2",
    "@sentry/nextjs": "^10.53.1",
    "@sortey/analytics": "workspace:*",
    "@sortey/api": "workspace:*",
    "@sortey/auth": "workspace:*",
    "@sortey/config": "workspace:*",
    "@sortey/db": "workspace:*",
    "@sortey/email": "workspace:*",
    "@sortey/flags": "workspace:*",
    "@sortey/i18n": "workspace:*",
    "@sortey/monitoring": "workspace:*",
    "@sortey/realtime": "workspace:*",
    "@sortey/ui": "workspace:*",
    "@sortey/validators": "workspace:*",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@trpc/tanstack-react-query": "catalog:",
    "better-auth": "catalog:",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-intl": "^4.12.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "superjson": "catalog:",
    "tailwind-merge": "^3.6.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@cloudflare/vite-plugin": "^1.37.2",
    "@cloudflare/vitest-pool-workers": "^0.16.13",
    "@playwright/test": "^1.60.0",
    "@sortey/tailwind-config": "workspace:*",
    "@sortey/tsconfig": "workspace:*",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/nextjs-vite": "catalog:",
    "@types/google.maps": "^3.64.1",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "@vitejs/plugin-react": "catalog:",
    "@vitejs/plugin-rsc": "^0.5.26",
    "jiti": "^2.7.0",
    "oxlint": "catalog:",
    "react-server-dom-webpack": "^19.2.6",
    "storybook": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "vinext": "^0.0.51",
    "vite": "catalog:",
    "vitest": "^4.1.7",
    "wrangler": "^4.93.0"
  }
}
