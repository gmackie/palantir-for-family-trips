{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sortey-app",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat"],
  "placement": { "mode": "smart" },
  "triggers": { "crons": ["*/5 * * * *"] },
  "build": {
    "command": "pnpm prebuild:vinext && VINEXT=1 pnpm with-env vinext build",
    "cwd": ".",
    "watch_dir": ["src", "worker", "../../packages"]
  },
  "main": "./worker/index.ts",
  "routes": [
    {
      "pattern": "sortey.app",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "APP_ENV": "production",
    "FG_APP": "sortey",
    "APP_URL": "https://sortey.app",
    "NEXT_PUBLIC_APP_URL": "https://sortey.app",
    "NEXT_PUBLIC_GOOGLE_MAPS_API_KEY": "AIzaSyCCz6GZeB8qfIXJhCmKtHqhhY9kW23IllQ"
  },
  "env": {
    "staging": {
      "vars": {
        "APP_ENV": "staging"
      }
    }
  },
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "sortie-receipts"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "71e7b1f713a841c4b98b4fa41c42ffef"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "TRIP_ROOM", "class_name": "TripRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TripRoom"] }]
}
