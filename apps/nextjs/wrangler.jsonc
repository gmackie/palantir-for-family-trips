{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trip-beta",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat"],
  "placement": { "mode": "smart" },
  "triggers": { "crons": ["*/5 * * * *"] },
  "build": {
    "command": "pnpm prebuild:vinext && VINEXT=1 pnpm with-env vinext build",
    "cwd": ".",
    "watch_dir": ["src", "worker", "../../packages"]
  },
  "main": "./worker/index.ts",
  "routes": [
    {
      "pattern": "beta.sortey.app",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "APP_ENV": "staging",
    "FG_APP": "sortey",
    "FG_STAGE": "beta",
    "SKIP_ENV_VALIDATION": "1",
    "APP_URL": "https://beta.sortey.app",
    "NEXT_PUBLIC_APP_URL": "https://beta.sortey.app",
    "NEXT_PUBLIC_GOOGLE_MAPS_API_KEY": "AIzaSyCCz6GZeB8qfIXJhCmKtHqhhY9kW23IllQ",
    "NEXT_PUBLIC_SENTRY_DSN": "https://569e9c22f10b15178541b945bf15a88f@o4509749405810688.ingest.us.sentry.io/4511437067911168",
    "SENTRY_ORG": "sortie-app",
    "SENTRY_PROJECT": "sortie-app"
  },
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "sortie-receipts"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fg-trip-beta",
      "database_id": "d133795d-334b-4777-b064-1d21578d3bda"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "TRIP_ROOM", "class_name": "TripRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TripRoom"] }]
}
