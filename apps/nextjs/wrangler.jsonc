{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sortie-gmac-io",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "pnpm prebuild:vinext && VINEXT=1 pnpm with-env vinext build",
    "cwd": ".",
    "watch_dir": ["src", "worker", "../../packages"]
  },
  "main": "./worker/index.ts",
  "routes": [
    {
      "pattern": "sortie.gmac.io",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "APP_ENV": "production",
    "APP_URL": "https://sortie.gmac.io",
    "NEXT_PUBLIC_APP_URL": "https://sortie.gmac.io",
    "NEXT_PUBLIC_GOOGLE_MAPS_API_KEY": "AIzaSyD-_6bRsv9VULS4cTMktQynRAGwvzO913w"
  },
  "env": {
    "staging": {
      "vars": {
        "APP_ENV": "staging"
      }
    }
  },
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "sortie-receipts"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "71e7b1f713a841c4b98b4fa41c42ffef"
    }
  ]
}
