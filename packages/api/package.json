{
  "name": "@sortey/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "default": "./src/openapi.ts"
    },
    "./versioning": {
      "types": "./dist/versioning.d.ts",
      "default": "./src/versioning.ts"
    },
    "./deprecation": {
      "types": "./dist/middleware/deprecation.d.ts",
      "default": "./src/middleware/deprecation.ts"
    },
    "./workspace": {
      "types": "./dist/workspace/index.d.ts",
      "default": "./src/workspace/index.ts"
    },
    "./ocr": {
      "types": "./dist/ocr/index.d.ts",
      "default": "./src/ocr/index.ts"
    },
    "./ocr/review": {
      "types": "./dist/ocr/review.d.ts",
      "default": "./src/ocr/review.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules coverage",
    "dev": "tsc",
    "format": "biome check .",
    "lint": "oxlint .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@google/generative-ai": "^0.24.1",
    "@sortey/auth": "workspace:*",
    "@sortey/config": "workspace:*",
    "@sortey/db": "workspace:*",
    "@sortey/email": "workspace:*",
    "@sortey/flags": "workspace:*",
    "@sortey/realtime": "workspace:*",
    "@sortey/validators": "workspace:*",
    "@trpc/server": "catalog:",
    "superjson": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@sortey/tsconfig": "workspace:*",
    "@sortey/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "openapi-types": "^12.1.3",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.7"
  }
}
