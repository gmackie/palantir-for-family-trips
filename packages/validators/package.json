{
  "name": "@sortey/validators",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./money": {
      "types": "./dist/money.d.ts",
      "default": "./src/money.ts"
    },
    "./status": {
      "types": "./dist/status.d.ts",
      "default": "./src/status.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "biome check .",
    "lint": "oxlint .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@sortey/tsconfig": "workspace:*",
    "@sortey/vitest-config": "workspace:*",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.7"
  }
}
