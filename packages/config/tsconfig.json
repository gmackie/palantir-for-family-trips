{
  "extends": "@sortey/tsconfig/base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "types": ["node"],
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "rewriteRelativeImportExtensions": true,
    "noEmit": false
