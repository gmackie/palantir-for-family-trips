{
  "name": "@gmacko/analytics",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./src/web/index.tsx"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "default": "./src/native/index.tsx"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "biome check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@gmacko/config": "workspace:*",
    "posthog-js": "^1.374.2",
    "posthog-react-native": "^4.45.10"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@gmacko/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "expo-constants": "~55.0.16",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "expo-constants": ">=17.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "expo-constants": {
      "optional": true
    }
  }
}
