{
  "name": "@sortey/analytics",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "default": "./src/events.ts"
    },
    "./facade": {
      "types": "./dist/facade.d.ts",
      "default": "./src/facade.ts"
    },
    "./flags": {
      "types": "./dist/flags.d.ts",
      "default": "./src/flags.ts"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./src/web/index.tsx"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "default": "./src/native/index.tsx"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "format": "biome check .",
    "lint": "oxlint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@sortey/config": "workspace:*",
    "dataflare-web": "0.8.4"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@sortey/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  }
}
