{
  "name": "create-gmacko-app",
  "private": true,
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^10.32.1"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "doctor": "./scripts/doctor.sh",
    "setup": "./scripts/setup.sh",
    "bootstrap:local": "./scripts/bootstrap-local.sh",
    "provision": "./scripts/provision.sh",
    "auth:generate": "pnpm -F @sortey/auth generate",
    "db:generate": "pnpm -F @sortey/db generate",
    "db:migrate": "pnpm -F @sortey/db migrate",
    "db:push": "turbo -F @sortey/db push",
    "db:check": "pnpm -F @sortey/db check",
    "db:seed": "pnpm -F @sortey/db seed",
    "db:studio": "turbo -F @sortey/db studio",
    "forge:init": "forge init --full",
    "forge:doctor": "forge doctor",
    "forge:status": "forge status",
    "forge:diff": "forge diff",
    "forge:apply": "forge apply",
    "forge:pull": "forge pull",
    "forge:stages": "forge stage list",
    "forge:deploy:staging": "forge deploy create staging --wait",
    "forge:deploy:production": "forge deploy create production --wait",
    "trpc:ops": "pnpm --filter @sortey/trpc-cli exec gmacko-ops",
    "mcp:app": "pnpm --filter @sortey/mcp-server exec gmacko-mcp",
    "dev": "turbo watch dev --continue",
    "dev:next": "turbo watch dev -F @sortey/nextjs...",
    "dev:mobile": "./scripts/dev-mobile.sh",
    "format": "turbo run format",
    "format:check": "biome check .",
    "format:fix": "biome check . --write",
    "lint": "turbo run lint",
    "lint:fix": "oxlint . --fix",
    "lint:ox": "oxlint .",
    "lint:ox:fix": "oxlint . --fix",
    "lint:ws": "pnpm dlx sherif@latest",
    "knip": "knip",
    "check:fast": "pnpm lint && pnpm typecheck",
    "check": "pnpm check:fast && pnpm test && pnpm build",
    "commitlint": "commitlint --from HEAD~1 --to HEAD",
    "postinstall": "pnpm lint:ws",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && lefthook install || true",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test -- --coverage",
    "e2e": "turbo run e2e",
    "e2e:web": "turbo run e2e -F @sortey/nextjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter='@sortey/mcp-server' --filter='@sortey/trpc-client' && changeset publish",
    "ui-add": "pnpm dlx shadcn@latest add && biome check src --write",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@forgegraph/cli": "^0.3.1",
    "@turbo/gen": "^2.9.14",
    "@types/suncalc": "^1.9.2",
    "dotenv-cli": "^11.0.0",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "oxlint": "catalog:",
    "turbo": "^2.9.14",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@googlemaps/polyline-codec": "^1.0.28",
    "suncalc": "^1.9.0"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "react-native": "0.85.3",
      "react-native-worklets": "0.8.3",
      "react-native-reanimated": "4.3.1",
      "@react-native/babel-plugin-codegen": "0.85.3",
      "@react-native/babel-preset": "0.85.3",
      "@react-native/codegen": "0.85.3",
      "@react-native/js-polyfills": "0.85.3",
      "@react-native/metro-babel-transformer": "0.85.3",
      "@react-native/metro-config": "0.85.3",
      "@react-native/assets-registry": "0.85.3",
      "@react-native/normalize-colors": "0.85.3",
      "@react-native/virtualized-lists": "0.85.3",
      "@react-native/gradle-plugin": "0.85.3"
    }
  },
  "version": "0.1.0.0"
}
